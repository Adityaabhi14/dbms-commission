# ==============================================================================
# APD MUSIC CLASS — ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# This template defines all required environment variables for development,
# staging, and production environments. Never commit real secrets to version control.
# Copy this file to '.env' and populate with target environment values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
VITE_PORT=5173
ACADEMY_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. CORS & TRUSTED ORIGINS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. In production, restrict to your verified domain.
CORS_ORIGIN=https://apdmusicclass.com,https://admin.apdmusicclass.com,http://localhost:5173

# ------------------------------------------------------------------------------
# 3. RELATIONAL DATABASE (POSTGRESQL)
# ------------------------------------------------------------------------------
# Connection string supporting connection pooling (PgBouncer or RDS/Supabase pooler)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apd_music_academy?schema=public&sslmode=prefer&connection_limit=20"
DATABASE_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/apd_music_academy?schema=public"

# Connection Pool Settings
DB_POOL_MIN=5
DB_POOL_MAX=25
DB_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHIC SECURITY & JWT SECRETS
# ------------------------------------------------------------------------------
# Generate using: openssl rand -base64 64
JWT_SECRET=replace_with_a_64_byte_cryptographically_secure_random_hex_or_base64_string
JWT_EXPIRES_IN=24h
COOKIE_SECRET=replace_with_a_secure_cookie_session_signing_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# ------------------------------------------------------------------------------
# 5. INITIAL OWNER PROVISIONING (ADMIN-CONTROLLED SETUP)
# ------------------------------------------------------------------------------
# Used exclusively by 'npm run setup:owner' to bootstrap the first academy director.
# Public owner self-registration is strictly disallowed in production.
INITIAL_OWNER_EMAIL=director@apdmusicclass.com
INITIAL_OWNER_PASSWORD=replace_with_a_strong_director_master_password
INITIAL_OWNER_NAME="Dr. Alok Prasad"
INITIAL_OWNER_PHONE="+91 98765 00001"

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAY INTEGRATION (SANDBOX / LIVE)
# ------------------------------------------------------------------------------
# Leave empty to run in Sandbox/Mock Mode. Populate with live credentials for production.
PAYMENT_GATEWAY_PROVIDER=razorpay # Options: razorpay | stripe | cashfree | mock
PAYMENT_GATEWAY_KEY=rzp_live_placeholder_key_id
PAYMENT_GATEWAY_SECRET=rzp_live_placeholder_secret_key
PAYMENT_WEBHOOK_SECRET=whsec_placeholder_signature_verification_key

# ------------------------------------------------------------------------------
# 7. NOTIFICATION & EMAIL SERVICE (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=replace_with_smtp_api_key
EMAIL_FROM="APD Music Class <admissions@apdmusicclass.com>"

# ------------------------------------------------------------------------------
# 8. AUDIT & STRUCTURED LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL=info # Options: debug | info | warn | error
ENABLE_AUDIT_LOGGING=true
